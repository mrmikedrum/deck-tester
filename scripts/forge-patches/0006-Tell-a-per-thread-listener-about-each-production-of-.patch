From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mrmikedrum <mrmikedrum@gmail.com>
Date: Tue, 3 Nov 2026 15:58:09 -0700
Subject: [PATCH] Tell a per-thread listener about each production of mana

A host that records Forge AI's mana payments needs every activation that made mana, in order, with
the mana it made, including abilities that paid another ability's cost through the pool.

Goldfish-Upstream: local only, a replay hook for this host.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../java/forge/game/spellability/AbilityManaPart.java  | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/forge-game/src/main/java/forge/game/spellability/AbilityManaPart.java b/forge-game/src/main/java/forge/game/spellability/AbilityManaPart.java
index 8171a902..189d89d7 100644
--- a/forge-game/src/main/java/forge/game/spellability/AbilityManaPart.java
+++ b/forge-game/src/main/java/forge/game/spellability/AbilityManaPart.java
@@ -84,6 +84,12 @@ public class AbilityManaPart implements java.io.Serializable {
 
     private transient Multiset<Mana> lastManaProduced = HashMultiset.create();
 
+    /**
+     * Told of each production of mana on this thread, as it happens: the ability that made it (null when an
+     * effect did) and each mana made. A host replaying games records payments with it.
+     */
+    public static final ThreadLocal<java.util.function.BiConsumer<SpellAbility, java.util.List<Mana>>> PRODUCED = new ThreadLocal<>();
+
     private transient Card sourceCard;
     private transient IHasSVars sVarHolder;
 
@@ -199,6 +205,10 @@ public class AbilityManaPart implements java.io.Serializable {
         }
 
         manaPool.addMana(this.lastManaProduced);
+        java.util.function.BiConsumer<SpellAbility, java.util.List<Mana>> listener = PRODUCED.get();
+        if (listener != null) {
+            listener.accept(root, new java.util.ArrayList<>(this.lastManaProduced));
+        }
 
         final Map<AbilityKey, Object> runParams = AbilityKey.mapFromCard(source);
         runParams.put(AbilityKey.Player, player);
