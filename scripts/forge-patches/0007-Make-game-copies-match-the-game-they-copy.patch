+    /** A spell, an activated ability or a triggered ability on the stack, as it is in the copy, with its choices. */
+    private SpellAbility copyStackEntry(SpellAbility origSa, IEntityMap lenient) {
+        Card newHost = (Card) lenient.map(origSa.getHostCard());
+        if (newHost == null) {
+            // the source left the game paying for it (a token sacrificed for its own ability): the ability still
+            // resolves, from the source as it last was, like the last-known copy the original game uses
+            final Card gone = origSa.getHostCard();
+            newHost = new CardCopyService(gone, lenient.getGame()).copyCard(false, playerMap.get(gone.getOwner()));
+            newHost.dangerouslySetGame(lenient.getGame());
+        }
+        final Player activator = playerMap.get(origSa.getActivatingPlayer());
+        if (origSa instanceof WrappedAbility wrapped) {
+            final SpellAbility inner = wrapped.getWrappedAbility();
+            final SpellAbility newInner = inner.copy(newHost, activator, false, true);
+            SpellAbilityChoiceCopier.copyTargets(inner, newInner, o -> mapStackReference(o, lenient));
+            newInner.setTriggeringObjects(mapTriggeringObjects(inner.getTriggeringObjects(), lenient));
+            final Player decider = wrapped.getDecider() == null ? null : playerMap.get(wrapped.getDecider());
+            final WrappedAbility newWrapped = new WrappedAbility(copyTrigger(wrapped.getTrigger(), newHost), newInner, decider);
+            newWrapped.setActivatingPlayer(activator);
+            newWrapped.setStackDescription(origSa.getStackDescription());
+            return newWrapped;
+        }
+        SpellAbility newSa = findSAInCard(origSa, newHost);
+        if (newSa == null) {
+            // a variant the card doesn't list (cast without paying its mana cost, for an alternative cost, a token's
+            // ability made by an effect): copy the ability itself, with what was chosen for it
+            newSa = origSa.copy(newHost, activator, false, true);
+            SpellAbilityChoiceCopier.copyTargets(origSa, newSa, o -> mapStackReference(o, lenient));
+            return newSa;
+        }
+        newSa.setActivatingPlayer(activator);
+        if (origSa.isSpell()) {
+            newSa = SpellAbilityChoiceCopier.copyCastChoices(origSa, newSa, activator);
+            if (newSa == null) {
+                return null;
             }
-        } 
+            chainChosenModes(origSa, newSa);
+        } else {
+            newSa.setXManaCostPaid(origSa.getXManaCostPaid());
+            chainChosenModes(origSa, newSa);
+        }
+        copyPaid(origSa, newSa, lenient);
+        SpellAbilityChoiceCopier.copyTargets(origSa, newSa, o -> mapStackReference(o, lenient));
+        return newSa;
+    }
+
+    /**
+     * A modal spell on the stack carries its chosen modes as its sub abilities (the chosen list is only kept while
+     * casting): chain the copy's own modes the same way, matched by their text.
+     */
+    private static void chainChosenModes(SpellAbility origSa, SpellAbility newSa) {
+        if (origSa.getApi() != ApiType.Charm || newSa.getSubAbility() != null) {
+            return;
+        }
+        List<AbilitySub> chosen = newSa.getChosenList();
+        if (chosen == null) {
+            chosen = new ArrayList<>();
+            final List<AbilitySub> choices = newSa.getAdditionalAbilityList("Choices");
+            for (SpellAbility mode = origSa.getSubAbility(); mode != null; mode = mode.getSubAbility()) {
+                for (AbilitySub choice : choices) {
+                    if (Objects.equals(choice.getParam("SpellDescription"), mode.getParam("SpellDescription"))) {
+                        chosen.add(choice);
+                        break;
+                    }
+                }
+            }
+        }
+        if (!chosen.isEmpty()) {
+            CharmEffect.chainAbilities(newSa, chosen);
+        }
+    }
+
+    private static CardCollection mapCards(Iterable<Card> cards, IEntityMap lenient) {
+        final CardCollection out = new CardCollection();
+        for (Card card : cards) {
+            final GameObject found = lenient.map(card);
+            if (found != null) {
+                out.add((Card) found);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * What was paid for an ability on the stack (the creature tapped to station, the cards sacrificed or discarded):
+     * its effect may count it. A card the copy doesn't have (it left the battlefield) stays as it was paid.
+     */
+    private static void copyPaid(SpellAbility origSa, SpellAbility newSa, IEntityMap lenient) {
+        final com.google.common.collect.TreeBasedTable<String, Boolean, CardCollection> paid = com.google.common.collect.TreeBasedTable.create();
+        for (com.google.common.collect.Table.Cell<String, Boolean, CardCollection> cell : origSa.getPaidHash().cellSet()) {
+            final CardCollection cards = new CardCollection();
+            for (Card c : cell.getValue()) {
+                final GameObject found = lenient.map(c);
+                cards.add(found != null ? (Card) found : c);
+            }
+            paid.put(cell.getRowKey(), cell.getColumnKey(), cards);
+        }
+        newSa.setPaidHash(paid);
+    }
+
+    /** The trigger of the copied card that a triggered ability on the stack came from; a copy of it if the card has none. */
+    private static Trigger copyTrigger(Trigger trigger, Card newHost) {
+        for (Trigger t : newHost.getTriggers()) {
+            if (t.getMapParams().equals(trigger.getMapParams())) {
+                return t;
+            }
+        }
+        return trigger.copy(newHost, false);
+    }
+
+    private GameObject mapStackReference(GameObject o, IEntityMap lenient) {
+        if (o instanceof SpellAbility) {
+            final SpellAbility found = stackMap.get(o);
+            if (found == null) {
+                throw new RuntimeException("Couldn't map " + o);
+            }
+            return found;
+        }
+        final GameObject found = lenient.map(o);
+        if (found == null) {
+            throw new RuntimeException("Couldn't map " + o);
+        }
+        return found;
+    }
+
+    /** What set off a triggered ability, as the copy has it; what the copy lacks stays as it was. */
+    private Map<AbilityKey, Object> mapTriggeringObjects(Map<AbilityKey, Object> objects, IEntityMap lenient) {
+        final Map<AbilityKey, Object> out = AbilityKey.newMap();
+        for (Map.Entry<AbilityKey, Object> e : objects.entrySet()) {
+            out.put(e.getKey(), mapTriggeringObject(e.getValue(), lenient));
+        }
+        return out;
+    }
+
+    private Object mapTriggeringObject(Object o, IEntityMap lenient) {
+        if (o instanceof SpellAbility && stackMap.containsKey(o)) {
+            return stackMap.get(o);
+        }
+        if (o instanceof Card || o instanceof Player) {
+            final GameObject found = lenient.map((GameObject) o);
+            return found != null ? found : o;
+        }
+        if (o instanceof CardCollectionView cards) {
+            final CardCollection out = new CardCollection();
+            for (Card c : cards) {
+                final GameObject found = lenient.map(c);
+                out.add(found != null ? (Card) found : c);
+            }
+            return out;
+        }
+        return o;
     }
 
