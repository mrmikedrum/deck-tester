From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mrmikedrum <mrmikedrum@gmail.com>
Date: Tue, 3 Nov 2026 15:58:09 -0700
Subject: [PATCH] Keep the AI's evaluation cache per thread

AiCache is one process-wide map that compares cards by id. Games running side by side have cards
with the same ids, so one game read another's evaluations. A cache per thread keeps each game's own.

Goldfish-Upstream: rework first. Upstream's AI also thinks on worker threads, where a per-thread
cache would stop sharing; keying the cache by game would fix both.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 forge-ai/src/main/java/forge/ai/AiCache.java | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/forge-ai/src/main/java/forge/ai/AiCache.java b/forge-ai/src/main/java/forge/ai/AiCache.java
index b98f7def..b6f343c8 100644
--- a/forge-ai/src/main/java/forge/ai/AiCache.java
+++ b/forge-ai/src/main/java/forge/ai/AiCache.java
@@ -3,7 +3,6 @@ package forge.ai;
 import com.google.common.collect.ArrayListMultimap;
 import com.google.common.collect.Lists;
 import com.google.common.collect.Multimap;
-import com.google.common.collect.Multimaps;
 
 import java.util.Arrays;
 import java.util.List;
@@ -13,7 +12,9 @@ import java.util.function.Supplier;
 public class AiCache {
 
     // stores result + args as vector
-    private final static Multimap<String, List<Object>> dataMap = Multimaps.synchronizedMultimap(ArrayListMultimap.create());
+    // Per thread: games run side by side on their own threads, and their cards compare equal by id across
+    // games, so a shared cache would hand one game another game's evaluations.
+    private final static ThreadLocal<Multimap<String, List<Object>>> dataMaps = ThreadLocal.withInitial(ArrayListMultimap::create);
 
     public static boolean identity(Object a, Object b) {
         return a == b;
@@ -24,6 +25,7 @@ public class AiCache {
     // for that you can pass Functions that compare the args
     public static <T> T getCached(String key, Supplier<T> func, List<BiFunction<Object, Object, Boolean>> argsCheck, Object... args) {
         // TODO would like a good strategy to derive default key, but there's no clean way to obtain the method name
+        Multimap<String, List<Object>> dataMap = dataMaps.get();
         for (List<Object> cached : Lists.newArrayList(dataMap.get(key))) {
             boolean hit = true;
             for (int i = 0; i < args.length; i++) {
@@ -46,7 +48,7 @@ public class AiCache {
 
     // TODO add different scopes + staleness indicator
     public static void clear() {
-        dataMap.clear();
+        dataMaps.get().clear();
     }
 
 }
