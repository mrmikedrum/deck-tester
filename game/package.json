{
  "name": "deckmaster-game",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint client/src client/test",
    "test": "vitest run",
    "behaviour": "playwright test -c tools/behaviour",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && node --test tools/*.test.js && npm run behaviour && BEHAVIOUR_BROWSERS=webkit npm run behaviour -- --grep @cast",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "playwright": "1.48.2",
    "preact": "11.2.0",
    "three": "0.187.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.48.2",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "happy-dom": "21.0.4",
    "knip": "6.48.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
